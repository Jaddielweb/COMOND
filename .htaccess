<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /COMOND/

    # Si la URL ya apunta a public/, dejarla sin cambios.
    RewriteRule ^public/ - [L]

    # En la raíz del proyecto, cargar public/index.php internamente.
    RewriteRule ^$ public/index.php [L]

    # Reescribir el resto de las URLs a public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
